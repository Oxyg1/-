# --- обязательное ---
BOT_TOKEN=123456:replace-me

# --- окружение Telegram ---
# true = тестовый сервер Telegram (там работают виджеты в группах, inline и пересылка)
USE_TEST_SERVER=false
# true = слать табло в группу (в проде виджеты работают только в личных чатах)
WIDGETS_IN_GROUPS=false
# true = регистрировать /cduel как эфемерную команду (текст команды не виден в группе)
EPHEMERAL_COMMANDS=true

DB_PATH=duelbot.db
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- тайминги (секунды) ---
CHALLENGE_TTL=300
STAKE_TTL=180
READY_TTL=90
# после отказа нельзя снова вызвать того же игрока столько секунд (защита от спама вызовами)
CHALLENGE_COOLDOWN=60
DELAY_MIN=2
DELAY_MAX=6
RESPONSE_TIMEOUT=5
PING_SAMPLES=1
DEFAULT_RTT_MS=150
MAX_RTT_MS=400
MIN_HUMAN_MS=80
TIE_MS=20
# cancel: нажал один, второй молчит -> дуэль отменена; win: победа нажавшему
ONE_SIDED_POLICY=cancel
# коэффициент K рейтинга Эло: больше — рейтинг меняется резче
ELO_K=32

# --- ставки: по умолчанию ВЫКЛЮЧЕНЫ (режим «на интерес») ---
ENABLE_STARS_STAKES=false
STARS_MIN=1
STARS_MAX=500
# необязательно: id подарка (getAvailableGifts), который бот дарит победителю за счёт своего баланса Stars
STARS_WINNER_GIFT_ID=

ENABLE_TON_STAKES=false
# сеть TON Connect: -239 = mainnet, -3 = testnet
TON_NETWORK=-239
# базовый URL индексатора toncenter API v3 (для тестнета укажите URL тестнетного индексатора)
TON_API_BASE=https://toncenter.com/api/v3
TON_API_KEY=
TON_MIN=0.1
TON_MAX=10
# запас на комиссию, который должен быть на кошельке плательщика (TON)
TON_FEE_RESERVE=0.05
# сколько секунд проигравшему даётся на оплату
TON_CLAIM_TTL=900
# комиссия владельца бота: доля проигрыша, которая уходит на кошелёк ниже (0 — без комиссии)
TON_FEE_PERCENT=8
TON_FEE_WALLET=UQA7piR2BSZsA7LBGvW_uoFUd0BEHGpA-zncuMDk5x_KFROG
