# Скопируй в server/.env и заполни

# Токен бота от @BotFather
BOT_TOKEN=

# Публичный HTTPS-адрес, где крутится этот сервер (его же указываешь в BotFather как URL Mini App)
APP_URL=https://frog.example.com

# Юзернейм бота без @ и короткое имя Mini App (BotFather → /newapp). Из них собирается ссылка t.me/bot/app?startapp=chat
BOT_USERNAME=
APP_NAME=

# ID ОСНОВНОГО игрового чата @FrogGame (отрицательное число вида -100xxxxxxxxxx). Туда идёт дневной отчёт.
# Бот должен быть в чате.
CHAT_ID=
CHAT_LINK=https://t.me/FrogGame

# Чат холдеров — только для владельцев Kissed Frog. Ссылка и id (id нужен, если позже
# захочешь отдельные посты для холдеров; для приглашений хватает ссылки).
HOLDERS_CHAT_LINK=https://t.me/kissed_frog_holders
HOLDERS_CHAT_ID=

# Твой Telegram ID — для команды /digest (отправить дневной отчёт вручную)
ADMIN_ID=

# Час дневного отчёта по UTC (18 = 21:00 по Москве)
DIGEST_HOUR=18

# Цель общего пруда на неделю (слияний)
POND_GOAL=50000

# Порт
PORT=8787

# DEV=1 разрешает запросы без подписи Telegram (для локального теста в браузере)
DEV=1

# --- Премиум-эмодзи для текстов бота ---
# ID кастомного эмодзи (custom_emoji_id). Работают, если у владельца бота есть Telegram Premium
# или бот купил доп. юзернейм на Fragment. Пусто = запасной обычный символ.
EMOJI_FROG=
EMOJI_TROPHY=
EMOJI_GOLD=
EMOJI_SILVER=
EMOJI_BRONZE=
EMOJI_CROWN=
EMOJI_SPARKLE=
EMOJI_WAVE=
EMOJI_HEART=
EMOJI_STAR=
# В подписях кнопок кастомные эмодзи невозможны. EMOJI_BUTTON=0 уберёт значок из кнопок совсем.
EMOJI_BUTTON=1
